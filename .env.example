# ==============================================================================
# HyperDrop — Stellar Testnet & AI Agent Environment Configuration
# Copy this file to .env (never commit real secrets).
# ==============================================================================

# --- AI Studio / Runtime ---
# GEMINI_API_KEY: Server-side key for @google/genai function calling & copilot.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Public URL where the web app is hosted.
APP_URL="http://localhost:3000"

# --- Stellar Testnet Network Endpoints ---
STELLAR_NETWORK="TESTNET"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
HORIZON_URL="https://horizon-testnet.stellar.org"

# --- Soroban Contract IDs (Stellar Testnet, C... StrKey addresses) ---
# Deployed YieldGuardPolicy contract from /contracts/yield-guard
YIELD_GUARD_CONTRACT_ID=""

# Blend lending pool contract ID on Stellar Testnet
BLEND_POOL_CONTRACT_ID=""

# DeFindex yield vault factory contract ID on Stellar Testnet
DEFINDEX_FACTORY_CONTRACT_ID=""

# Soroswap router contract ID on Stellar Testnet
SOROSWAP_ROUTER_CONTRACT_ID=""

# --- Non-Custodial Agent Identity (Public Key Only) ---
# Authorized agent_signer G... address registered in YieldGuardPolicy.
# HyperDrop NEVER holds user private keys; users sign every XDR in their wallet.
AGENT_PUBLIC_KEY=""

# --- Client-Safe Public Variables (/apps/web) ---
NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_HORIZON_URL="https://horizon-testnet.stellar.org"
NEXT_PUBLIC_YIELD_GUARD_CONTRACT_ID=""
